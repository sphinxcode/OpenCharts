# Freqtrade webserver base origin (no trailing slash, no path). The adapter
# appends /api/v1 itself — see src/services/api/request.ts and
# src/services/freqtrade/client.ts. Contract verified against the live
# backend in trading/docs/plans/VERIFIED-API-CONTRACT.md.
VITE_API_URL=https://trading.sphinx.codes

# MVP-only, client-bundled Freqtrade login (HTTP Basic → JWT) for the public
# read/backtest-only Trading Lab terminal. These end up inlined into the
# built JS bundle (Vite VITE_ vars are public) — that's an accepted interim
# trade-off for a signals-lab with no real capital (backtest/dry-run only,
# see the plan's R11/R12), NOT a real per-user auth model. Leave both unset
# to boot the terminal in offline mode: the chart shows no candles, but paper
# trading still works (it's demo-engine-backed regardless of this backend).
# VITE_FT_USERNAME=
# VITE_FT_PASSWORD=
